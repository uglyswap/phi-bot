# Blank systemd machine of the Phi Bot end-to-end test (spec 15.2): the base image plus only
# systemd, dbus, sudo, curl and certificates. Everything else (Node.js, Phi Bot's system packages)
# is installed by the test itself, as on a customer's server. Digest read on 2026-10-09.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ENV container=docker DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv dbus sudo curl ca-certificates \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && systemctl mask systemd-firstboot.service systemd-udevd.service getty.target console-getty.service
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
